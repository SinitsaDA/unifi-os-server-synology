# Copy to .env and adjust.

# UniFi OS Server version (= image tag). Changed automatically by the updater.
UOS_VERSION=5.1.42
# Image (built from the official installer by this repository's GitHub Actions).
UOS_IMAGE=ghcr.io/sinitsada/unifi-os-server

# IP address or DNS name of the NAS that UniFi devices use for inform (http://<it>:8080/inform).
UOS_SYSTEM_IP=192.168.1.10

# Port of the UniFi OS web interface on the NAS (https://<NAS>:11443).
UOS_WEB_PORT=11443

# Absolute path of this directory on the NAS (the updater mounts it at the same path).
UOS_DIR=/volume1/docker/unifi-os-server

# Compose project name - name the Container Manager project the same.
COMPOSE_PROJECT_NAME=unifi-os-server

TZ=Europe/Moscow

# ---------- Automatic updates ----------

# Daily check for new releases (1/0).
AUTO_UPDATE=1
# Update when "Update" is pressed in the UniFi OS console (1/0).
CONSOLE_UPDATE=1

# Daily check for a new release (local time).
UPDATE_TIME=04:30
# Install a release only when it is at least this many days old (0 = right away).
MIN_AGE_DAYS=2
# Full data backups kept in ./backups.
KEEP_BACKUPS=5
# Seconds to wait for UniFi OS to come up after an update before rolling back.
HEALTH_TIMEOUT=900

# Optional: GitHub token with actions:write on the image repository. When the console asks for a
# version whose image is not built yet, the updater starts its build instead of waiting for the
# scheduled one (up to 3 hours).
GITHUB_TOKEN=
